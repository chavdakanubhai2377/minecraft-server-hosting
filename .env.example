# Database Configuration
DATABASE_URL=postgresql://pghost_user:pghost_password_secure@localhost:5432/pghost_db
POSTGRES_USER=pghost_user
POSTGRES_PASSWORD=pghost_password_secure
POSTGRES_DB=pghost_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Backend Configuration
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION=24h

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@pghost.com

# Discord Webhook (Optional)
DISCORD_WEBHOOK_URL=

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=/uploads

# Minecraft Server Settings
MINECRAFT_JAVA_PATH=/usr/bin/java
MINECRAFT_EULA_AGREEMENT=true
SERVER_PORT_MIN=25565
SERVER_PORT_MAX=25700

# Docker Settings
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=pghost-network

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
GRAFANA_PASSWORD=admin

# Daemon Configuration
DAEMON_PORT=3002
DAEMON_HOST=0.0.0.0

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/backups

# AWS S3 (Optional for backups)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Analytics (Optional)
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=
